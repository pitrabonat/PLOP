<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-independent Unity sources (PLOP.Core/Solver/Generation) against netstandard2.1,
       the same API level Unity uses, so tests and the benchmark run with plain `dotnet`. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Plop.Lib</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Solver/**/*.cs" />
    <Compile Include="../../Assets/Scripts/LevelGeneration/**/*.cs" />
  </ItemGroup>
</Project>
